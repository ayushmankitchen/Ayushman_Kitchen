ENVIRONMENT=development
MONGO_URL=mongodb://localhost:27017
DB_NAME=workforce
MONGO_SERVER_SELECTION_TIMEOUT_MS=5000
MONGO_CONNECT_TIMEOUT_MS=5000
JWT_SECRET=your-secure-jwt-secret-min-32-chars
CORS_ORIGINS=http://localhost:3000
FRONTEND_URL=http://localhost:3000
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
SESSION_MAX_AGE_SECONDS=5184000
SESSION_MAX_AGE_SECONDS=28800

BUSINESS_TIMEZONE=Asia/Kolkata

# Brevo Email Configuration (for Admin password reset)
BREVO_API_KEY=
BREVO_SENDER_EMAIL=noreply@workforce.app
BREVO_SENDER_NAME=WorkForce
PASSWORD_RESET_URL=http://localhost:3000/reset-password

# Media Storage (use local in development and cloudinary in production)
MEDIA_STORAGE=local
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
