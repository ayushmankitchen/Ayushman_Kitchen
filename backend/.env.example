ENVIRONMENT=development
MONGO_URL=mongodb://localhost:27017
DB_NAME=ayushman_kitchen
MONGO_SERVER_SELECTION_TIMEOUT_MS=5000
MONGO_CONNECT_TIMEOUT_MS=5000
JWT_SECRET=__your_jwt_secret_min_32_chars__
CORS_ORIGINS=http://localhost:3000,http://localhost:3003
FRONTEND_URL=http://localhost:3000
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
SESSION_MAX_AGE_SECONDS=5184000

BUSINESS_TIMEZONE=Asia/Kolkata

# Brevo Email Configuration (Optional)
BREVO_API_KEY=__apikey__
BREVO_SENDER_EMAIL=your_email@example.com
BREVO_SENDER_NAME=Ayushman Kitchen
PASSWORD_RESET_URL=http://localhost:3000/reset-password

# Media Storage (local or cloudinary - Optional)
MEDIA_STORAGE=local
CLOUDINARY_CLOUD_NAME=__your_cloud_name__
CLOUDINARY_API_KEY=__apikey__
CLOUDINARY_API_SECRET=__apikey_secret__

# Web Push Notifications (Optional)
VAPID_PUBLIC_KEY=__vapid_public_key__
VAPID_PRIVATE_KEY=__vapid_private_key__
VAPID_SUBJECT=mailto:your_email@example.com
